{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Nummio",
  "version": "1.1.0",
  "brand": {
    "graphite": "#0B0F14",
    "charcoal": "#151B22",
    "bone": "#F2F1ED",
    "signal": "#B7FF63",
    "iris": "#A38CFF",
    "steel": "#A5A9B8"
  },
  "typography": {
    "sans": "Space Grotesk",
    "mono": "Geist Mono",
    "fallbackSans": "Inter, system-ui, sans-serif",
    "fallbackMono": "ui-monospace, SFMono-Regular, monospace"
  },
  "themes": {
    "dark": {
      "background": "#0B0F14",
      "backgroundSubtle": "#10161C",
      "surface": "#151B22",
      "surfaceRaised": "#1D252E",
      "foreground": "#F2F1ED",
      "foregroundMuted": "#A5A9B8",
      "border": "#34404A",
      "accent": "#B7FF63",
      "accentForeground": "#0B0F14",
      "research": "#A38CFF",
      "focus": "#B7FF63"
    },
    "light": {
      "background": "#F2F1ED",
      "backgroundSubtle": "#EAE9E4",
      "surface": "#FFFFFF",
      "surfaceRaised": "#F9F8F5",
      "foreground": "#0B0F14",
      "foregroundMuted": "#4B5661",
      "border": "#CED2D2",
      "accent": "#335D00",
      "accentForeground": "#FFFFFF",
      "research": "#5B3CC2",
      "focus": "#335D00"
    }
  },
  "spacingPx": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64,
    80,
    96,
    128
  ],
  "radiusPx": {
    "xs": 4,
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24
  },
  "timingMs": {
    "fast": 120,
    "base": 200,
    "slow": 400
  },
  "content": {
    "maxWidthPx": 1216,
    "copyWidthPx": 736
  },
  "notes": [
    "CSS is canonical runtime source; JSON is a tooling manifest.",
    "Brand Signal #B7FF63 remains constant; semantic accent changes in light theme for contrast.",
    "Dark mode is the default; theme must be explicitly toggled and persisted by app."
  ]
}
