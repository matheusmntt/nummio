{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Nummio Design System",
  "version": "2.0.0",
  "domain": "nummio.dev",
  "tagline": "Curiosity, engineered.",
  "positioning": "High-performance modern UI/UX engineering & applied research lab",
  "colors": {
    "graphite": "#0B0F14",
    "charcoal": "#151B22",
    "bone": "#F2F1ED",
    "signal": "#B7FF63",
    "iris": "#A38CFF",
    "steel": "#A5A9B8"
  },
  "themes": {
    "signalCore": {
      "id": "signal-core",
      "label": "Signal Core (Default — Preserved)",
      "mode": "dark",
      "description": "Original Nummio identity. Deep obsidian graphite with electric Signal Lime CTA and Iris research accents.",
      "primitives": {
        "graphite": "#0B0F14",
        "charcoal": "#151B22",
        "bone": "#F2F1ED",
        "signal": "#B7FF63",
        "iris": "#A38CFF",
        "steel": "#A5A9B8"
      },
      "semantic": {
        "bgCanvas": "#0B0F14",
        "bgSurface1": "#11161D",
        "bgSurface2": "#151B22",
        "bgSurface3": "#1C242E",
        "bgGlass": "rgba(21, 27, 34, 0.72)",
        "textPrimary": "#F2F1ED",
        "textSecondary": "#A5A9B8",
        "textMuted": "#6E7485",
        "textOnAccent": "#0B0F14",
        "accentPrimary": "#B7FF63",
        "accentPrimaryHover": "#C8FF85",
        "accentSecondary": "#A38CFF",
        "borderSubtle": "rgba(242, 241, 237, 0.07)",
        "borderDefault": "rgba(242, 241, 237, 0.12)",
        "borderStrong": "rgba(242, 241, 237, 0.22)"
      }
    },
    "cyberInfrared": {
      "id": "cyber-infrared",
      "label": "Cyber Infrared (Alternative A — Hardware Telemetry)",
      "mode": "dark",
      "description": "Precision CNC hardware and low-light cockpit interface palette with International Orange and Laser Amber.",
      "primitives": {
        "obsidian": "#090B0E",
        "titanium": "#12161F",
        "alabaster": "#F4F2ED",
        "infrared": "#FF5526",
        "amber": "#FFB020",
        "slate": "#949BA8"
      },
      "semantic": {
        "bgCanvas": "#090B0E",
        "bgSurface1": "#0E1118",
        "bgSurface2": "#12161F",
        "bgSurface3": "#1A202C",
        "bgGlass": "rgba(18, 22, 31, 0.75)",
        "textPrimary": "#F4F2ED",
        "textSecondary": "#949BA8",
        "textMuted": "#616875",
        "textOnAccent": "#090B0E",
        "accentPrimary": "#FF5526",
        "accentPrimaryHover": "#FF6E47",
        "accentSecondary": "#FFB020",
        "borderSubtle": "rgba(244, 242, 237, 0.07)",
        "borderDefault": "rgba(244, 242, 237, 0.13)",
        "borderStrong": "rgba(244, 242, 237, 0.24)"
      }
    },
    "quantumCyan": {
      "id": "quantum-cyan",
      "label": "Quantum Cyan (Alternative B — Shader & Data Pro)",
      "mode": "dark",
      "description": "Engineered for dense telemetry dashboards, GPU shader pipelines, and node-graph canvases.",
      "primitives": {
        "voidNavy": "#070B12",
        "carbon": "#0F1724",
        "crispIce": "#EFF5FB",
        "quantum": "#00F0FF",
        "indigo": "#818CF8",
        "coolSteel": "#8B9BB4"
      },
      "semantic": {
        "bgCanvas": "#070B12",
        "bgSurface1": "#0B111C",
        "bgSurface2": "#0F1724",
        "bgSurface3": "#162235",
        "bgGlass": "rgba(15, 23, 36, 0.74)",
        "textPrimary": "#EFF5FB",
        "textSecondary": "#8B9BB4",
        "textMuted": "#58677E",
        "textOnAccent": "#070B12",
        "accentPrimary": "#00F0FF",
        "accentPrimaryHover": "#47F5FF",
        "accentSecondary": "#818CF8",
        "borderSubtle": "rgba(239, 245, 251, 0.07)",
        "borderDefault": "rgba(239, 245, 251, 0.13)",
        "borderStrong": "rgba(239, 245, 251, 0.24)"
      }
    },
    "architecturalBone": {
      "id": "architectural-bone",
      "label": "Architectural Bone (Alternative C — Editorial Daylight)",
      "mode": "light",
      "description": "High-craft daylight theme for research papers, documentation, and high-ambient-light workstations.",
      "primitives": {
        "warmBone": "#F4F3EE",
        "stone": "#EAE8E0",
        "graphiteInk": "#0B0F14",
        "acidMoss": "#58B800",
        "deepIris": "#6E56CF",
        "pewter": "#5C6270"
      },
      "semantic": {
        "bgCanvas": "#F4F3EE",
        "bgSurface1": "#EEECE5",
        "bgSurface2": "#EAE8E0",
        "bgSurface3": "#DFDDD3",
        "bgGlass": "rgba(244, 243, 238, 0.80)",
        "textPrimary": "#0B0F14",
        "textSecondary": "#5C6270",
        "textMuted": "#878D9B",
        "textOnAccent": "#FFFFFF",
        "accentPrimary": "#58B800",
        "accentPrimaryHover": "#4B9E00",
        "accentSecondary": "#6E56CF",
        "borderSubtle": "rgba(11, 15, 20, 0.07)",
        "borderDefault": "rgba(11, 15, 20, 0.13)",
        "borderStrong": "rgba(11, 15, 20, 0.24)"
      }
    }
  },
  "typography": {
    "display": "Space Grotesk",
    "ui": "Inter",
    "mono": "Geist Mono",
    "fallbacks": {
      "display": "\"Space Grotesk\", \"Inter Display\", Inter, sans-serif",
      "ui": "Inter, \"Space Grotesk\", -apple-system, sans-serif",
      "mono": "\"Geist Mono\", \"JetBrains Mono\", monospace"
    },
    "openTypeFeatures": {
      "display": "'ss01' 1, 'cv01' 1",
      "mono": "'tnum' 1, 'zero' 1"
    }
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "pill": "9999px"
  },
  "spacingBase": "4px",
  "motion": {
    "targetFrameRate": "120fps",
    "easings": {
      "outExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "outQuart": "cubic-bezier(0.25, 1, 0.5, 1)",
      "inOutCubic": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "durations": {
      "micro": "110ms",
      "fast": "180ms",
      "normal": "280ms",
      "slow": "450ms"
    }
  }
}
